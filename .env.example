# Correos transaccionales (Resend). El dominio zutra.cl debe estar verificado.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
ADMIN_EMAIL=hola@zutra.cl

# Analytics & SEO
PUBLIC_GTM_ID=GTM-XXXXXX
PUBLIC_RECAPTCHA_SITE_KEY=6Lc...

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Sanity CMS Configuration
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_AUTH_TOKEN=
SANITY_USE_PREVIEW=false
PUBLIC_SANITY_PROJECT_ID=

# Contentful (solo para scripts de migración)
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=
# CONTENTFUL_PREVIEW_TOKEN=
# CONTENTFUL_ENVIRONMENT=master
# CONTENTFUL_MANAGEMENT_TOKEN=
# CONTENTFUL_PREVIEW_SECRET=
# CONTENTFUL_USE_PREVIEW=

# Sentry Error Tracking
SENTRY_DSN=

# Report access protection (generate with: openssl rand -hex 32)
OTP_SECRET=
