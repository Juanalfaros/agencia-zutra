{
  "name": "agencia-zutra",
  "type": "module",
  "version": "2.6.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && echo '{\"name\":\"agencia-zutra\",\"compatibility_date\":\"2025-01-01\",\"pages_build_output_dir\":\"../client\",\"compatibility_flags\":[\"nodejs_compat\"]}' > dist/server/wrangler.json && cp -r dist/server/* dist/client/ && mv dist/client/entry.mjs dist/client/_worker.js",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "simple-git-hooks",
    "deploy": "pnpm build && wrangler pages deploy dist/client",
    "deploy:dry": "pnpm build && wrangler pages publish dist/client --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/ph": "^1.2.2",
    "@nanostores/persistent": "^1.3.5",
    "@phosphor-icons/web": "^2.1.2",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.9.0",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "groq": "^6.19.0",
    "nanostores": "^1.5.5",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "lint-staged": {
    "!(studio/**/*)*.{js,ts,astro}": [
      "eslint --fix",
      "prettier --write --ignore-path .prettierignore"
    ],
    "*.{css,json,md}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm typecheck && pnpm test"
  }
}
