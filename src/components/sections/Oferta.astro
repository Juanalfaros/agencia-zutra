---
import { ofertaNucleo, complementos, partner } from '@/data/oferta';
---

<section id="servicios" class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Qué hacemos</h2>
      <p class="section-subtitle">
        Tres formas de trabajar con nosotros. Si no sabes cuál te conviene, lo
        vemos juntos en el diagnóstico.
      </p>
    </div>

    <div class="oferta-grid">
      {
        ofertaNucleo.map((o) => (
          <article
            class={`oferta-card ${o.featured ? 'oferta-card--featured' : ''}`}
          >
            <h3 class="oferta-card__title">{o.title}</h3>
            <p class="oferta-card__tagline">{o.tagline}</p>
            <ul class="oferta-card__list">
              {o.items.map((item) => (
                <li>
                  <i class="ph-duotone ph-check-circle text-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a
              href={o.href}
              class={`button ${o.featured ? 'button--primary' : 'button--secondary'}`}
              data-track="cta_oferta_click"
              data-loc={o.title}
            >
              {o.cta}
            </a>
          </article>
        ))
      }
    </div>

    <div class="oferta-extras">
      <p class="oferta-extras__line">
        <strong>Complementos:</strong>
        {
          complementos.map((c, i) => (
            <>
              <a href={c.href}>{c.title}</a>
              {i < complementos.length - 1 ? ' · ' : ''}
            </>
          ))
        }
      </p>
      <p class="oferta-extras__line">
        <strong>{partner.title}:</strong>
        {partner.text}
        <a href={partner.href}>Ver Partner →</a>
      </p>
    </div>
  </div>
</section>

<style>
  .oferta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .oferta-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background-color: var(--color-surface, transparent);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .oferta-card:hover,
  .oferta-card--featured {
    border-color: var(--color-accent);
  }

  .oferta-card:hover {
    transform: translateY(-2px);
  }

  .oferta-card__title {
    font-size: 1.75rem;
    margin: 0;
  }

  .oferta-card__tagline {
    color: var(--color-muted);
    margin: 0;
  }

  .oferta-card__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .oferta-card__list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .oferta-card .button {
    margin-top: auto;
    justify-content: center;
  }

  .oferta-extras {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
    color: var(--color-muted);
  }

  .oferta-extras__line {
    margin: 0;
  }

  .oferta-extras a {
    color: var(--color-accent);
  }
</style>
