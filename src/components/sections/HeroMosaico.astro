---
import { getSanityClient, groq } from '@/lib/sanity';
import { CASE_STUDY_FIELDS } from '@/lib/sanity-queries';
import { adaptCaseStudy } from '@/lib/sanity-adapters';

const client = await getSanityClient();
const docs = await client.fetch(
  groq`*[_type == "caseStudy"] | order(order asc, _createdAt desc) { ${CASE_STUDY_FIELDS} }`
);
const cases = docs
  .map(adaptCaseStudy)
  .filter((c: any) => c.featuredImage?.src?.src);

// Reparte los casos en 3 columnas (1, 4, 7 / 2, 5, 8 / 3, 6, 9)
const columns = [0, 1, 2].map((col) =>
  cases.filter((_: any, i: number) => i % 3 === col)
);
---

<div class="mosaico" role="group" aria-label="Algunos de nuestros proyectos">
  {
    columns.map((items: any[], col: number) => (
      <div class={`mosaico__col mosaico__col--${col}`}>
        <div class="mosaico__track">
          {[0, 1].map((copy) =>
            items.map((c: any, i: number) => (
              <a
                href={`/portfolio/${c.slug}`}
                class="mosaico__card"
                aria-hidden={copy === 1 ? 'true' : undefined}
                tabindex={copy === 1 ? -1 : undefined}
                aria-label={copy === 0 ? c.title : undefined}
              >
                <img
                  src={c.featuredImage.src.src}
                  alt=""
                  width="400"
                  height="440"
                  loading={copy === 0 && i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span class="mosaico__label">{c.title}</span>
              </a>
            ))
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  .mosaico {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    overflow: hidden;
    border-radius: var(--radius-lg, 1.25rem);
    transform: rotate(-5deg) scale(1.02);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 12%,
      #000 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 12%,
      #000 88%,
      transparent 100%
    );
  }

  .mosaico__col {
    overflow: hidden;
    height: 100%;
  }

  .mosaico__track {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    will-change: transform;
    animation: mosaico-sube 46s linear infinite;
  }

  .mosaico__col--1 .mosaico__track {
    animation-name: mosaico-baja;
    animation-duration: 52s;
  }

  .mosaico__col--2 .mosaico__track {
    animation-duration: 40s;
  }

  .mosaico:hover .mosaico__track {
    animation-play-state: paused;
  }

  .mosaico__card {
    position: relative;
    display: block;
    flex-shrink: 0;
    aspect-ratio: 10 / 11;
    border-radius: var(--radius-md, 0.75rem);
    overflow: hidden;
    background: var(--color-subtle);
  }

  .mosaico__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .mosaico__card:hover img {
    transform: scale(1.06);
  }

  .mosaico__label {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 0.6rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mosaico__card:hover .mosaico__label,
  .mosaico__card:focus-visible .mosaico__label {
    opacity: 1;
  }

  /* El track contiene dos copias: se desplaza media altura para cerrar el ciclo */
  @keyframes mosaico-sube {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, calc(-50% - 0.375rem), 0);
    }
  }

  @keyframes mosaico-baja {
    from {
      transform: translate3d(0, calc(-50% - 0.375rem), 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mosaico__track {
      animation: none;
    }
  }
</style>
