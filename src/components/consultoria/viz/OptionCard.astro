---
import { renderPortableText } from '@/lib/sanity-adapters';

interface Props {
  variant?: string;
  icon?: string;
  title: string;
  description?: any;
  recommended?: boolean;
  pros?: string[];
  cons?: string[];
  price?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  variant,
  icon,
  title,
  description,
  recommended = false,
  pros = [],
  cons = [],
  price,
  ctaText,
  ctaLink,
} = Astro.props;

const renderDesc = (desc: any): string => {
  if (!desc) return '';
  if (typeof desc === 'string') return `<p>${desc}</p>`;
  return renderPortableText(desc);
};
---

<article class={`ocard${recommended ? ' ocard--recommended' : ''}`}>
  {recommended && <div class="ocard__badge">Recomendado</div>}

  <div class="ocard__top">
    {
      icon ? (
        <span class="ocard__icon">
          <i class={`ph-duotone ${icon}`} aria-hidden="true" />
        </span>
      ) : (
        variant && (
          <span class="ocard__variant-num">{variant.replace(/\D/g, '')}</span>
        )
      )
    }
    <div class="ocard__meta">
      {variant && <p class="ocard__variant">{variant}</p>}
      <h3 class="ocard__title">{title}</h3>
    </div>
  </div>

  {
    description && (
      <div class="ocard__description" set:html={renderDesc(description)} />
    )
  }

  {
    (pros.length > 0 || cons.length > 0) && (
      <div class="ocard__lists">
        {pros.length > 0 && (
          <ul class="ocard__list ocard__list--pros">
            {pros.map((p) => (
              <li>
                <i class="ph ph-plus-circle" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        )}
        {cons.length > 0 && (
          <ul class="ocard__list ocard__list--cons">
            {cons.map((c) => (
              <li>
                <i class="ph ph-minus-circle" aria-hidden="true" />
                <span>{c}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }

  {
    (price || ctaText) && (
      <footer class="ocard__footer">
        {price && <strong class="ocard__price">{price}</strong>}
        {ctaText && ctaLink ? (
          <a href={ctaLink} class="ocard__cta">
            {ctaText}
          </a>
        ) : (
          ctaText && <p class="ocard__cta-text">{ctaText}</p>
        )}
      </footer>
    )
  }
</article>

<style>
  .ocard {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    min-width: 0;
    /* border-top: 3px solid transparent; */
    transition:
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }

  .ocard:hover {
    border-color: rgba(var(--color-accent-rgb), 0.4);
    border-top-color: rgba(var(--color-accent-rgb), 0.4);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .ocard--recommended {
    border-color: var(--color-accent);
    border-top: 3px solid var(--color-accent);
    box-shadow:
      0 0 0 1px rgba(var(--color-accent-rgb), 0.15),
      0 8px 32px rgba(var(--color-accent-rgb), 0.12);
  }

  .ocard--recommended:hover {
    border-color: var(--color-accent);
    border-top-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow:
      0 0 0 1px rgba(var(--color-accent-rgb), 0.25),
      0 12px 40px rgba(var(--color-accent-rgb), 0.2);
  }

  /* Badge */
  .ocard__badge {
    position: absolute;
    top: -1rem;
    left: 1.25rem;
    padding: 0.25rem 0.875rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 0.5rem;
  }

  /* Top section: icon/num + meta */
  .ocard__top {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .ocard__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    min-width: 3rem;
    border-radius: 0.75rem;
    background: rgba(var(--color-accent-rgb), 0.1);
    border: 1px solid rgba(var(--color-accent-rgb), 0.2);
    font-size: 1.5rem;
    color: var(--color-accent);
    line-height: 1;
  }

  .ocard--recommended .ocard__icon {
    background: rgba(var(--color-accent-rgb), 0.18);
    border-color: rgba(var(--color-accent-rgb), 0.35);
  }

  .ocard__variant-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    min-width: 3rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-line);
    font-size: 1.125rem;
    font-weight: 900;
    color: var(--color-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .ocard__meta {
    flex: 1;
    min-width: 0;
  }

  .ocard__variant {
    margin: 0 0 0.25rem;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .ocard__title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--color-secondary);
    line-height: 1.3;
  }

  /* Description */
  .ocard__description {
    font-size: 0.875rem;
    color: var(--color-gray-300);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    flex-shrink: 0;

    p {
      font-size: 0.975rem;
    }
  }

  .ocard__description p {
    margin: 0 0 0.5rem;
  }
  .ocard__description p:last-child {
    margin-bottom: 0;
  }

  /* Lists */
  .ocard__lists {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .ocard__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .ocard__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-gray-300);
  }

  .ocard__list li i {
    margin-top: 0.175rem;
    flex-shrink: 0;
    font-size: 1rem;
  }

  .ocard__list--pros li i {
    color: #4ade80;
  }
  .ocard__list--cons li i {
    color: #f87171;
  }

  /* Footer */
  .ocard__footer {
    margin-top: auto;
    padding-top: 1.125rem;
    border-top: 1px solid var(--color-line);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .ocard--recommended .ocard__footer {
    border-color: rgba(var(--color-accent-rgb), 0.2);
  }

  .ocard__price {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--color-secondary);
    line-height: 1;
  }

  .ocard--recommended .ocard__price {
    color: var(--color-accent);
  }

  .ocard__cta-text {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .ocard__cta {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .ocard__cta:hover {
    text-decoration: underline;
  }
</style>
