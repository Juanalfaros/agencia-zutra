---
interface BarItem {
  label: string;
  value: string | number;
  percentage?: number;
  highlight?: boolean;
}

interface Props {
  title?: string;
  items: BarItem[];
}

const { title, items = [] } = Astro.props;

const numericValues = items.map((i) => {
  const valStr = String(i.value ?? '');
  const cleanStr = valStr.replace(/[^\d.,]/g, '');
  // Thousands separators check
  if (
    (cleanStr.match(/[.,]/g) || []).length > 1 ||
    /[.,]\d{3}$/.test(cleanStr)
  ) {
    return parseFloat(cleanStr.replace(/[.,]/g, '')) || 0;
  }
  return parseFloat(cleanStr.replace(/,/g, '.')) || 0;
});
const maxValue = Math.max(...numericValues, 1);

const computed = items.map((item, idx) => {
  const raw = numericValues[idx];
  const pct = Math.min(100, Math.max(0, Math.round((raw / maxValue) * 100)));
  return { ...item, pct, raw };
});
---

<div class="barchart-wrapper reveal">
  {title && <h4 class="barchart-title">{title}</h4>}
  <div class="barchart-container">
    {
      computed.map((item) => (
        <div class="barchart-row">
          <div class="barchart-label">{item.label}</div>
          <div class="barchart-bar-area">
            <div
              class={`barchart-fill${item.highlight ? ' is-highlighted' : ''}`}
              style={`flex:${item.pct}`}
            >
              <span class="barchart-value">{item.value}</span>
            </div>
            <div class="barchart-spacer" style={`flex:${100 - item.pct}`} />
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .barchart-wrapper {
    margin: 2rem 0;
    padding: 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-surface);
  }

  .barchart-title {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .barchart-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .barchart-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0.75rem;
    align-items: center;
  }

  @media (max-width: 520px) {
    .barchart-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .barchart-label {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-gray-400);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 520px) {
    .barchart-label {
      text-align: left;
      font-size: 0.7rem;
    }
  }

  .barchart-bar-area {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .barchart-spacer {
    flex-shrink: 1;
    min-width: 0;
  }

  .barchart-fill {
    display: flex;
    align-items: center;
    height: 2rem;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 0.375rem;
    min-width: 2.5rem;
    flex-shrink: 0;
  }

  .barchart-fill.is-highlighted {
    background: var(--color-accent);
    box-shadow: 0 0 12px rgba(var(--color-accent-rgb), 0.35);
  }

  .barchart-value {
    padding-left: 0.625rem;
    font-size: 0.8125rem;
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-secondary);
    white-space: nowrap;
  }

  .barchart-fill.is-highlighted .barchart-value {
    color: var(--color-on-accent);
  }
</style>
