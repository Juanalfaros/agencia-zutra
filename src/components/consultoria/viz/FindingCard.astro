---
interface Props {
  type: 'critical' | 'warning' | 'opportunity' | 'tip';
  title: string;
  description?: string;
}

const { type, title, description } = Astro.props;

const icons: Record<string, string> = {
  critical: 'ph-warning-octagon',
  warning: 'ph-warning',
  opportunity: 'ph-rocket-launch',
  tip: 'ph-lightbulb',
};

const icon = icons[type] || 'ph-info';
---

<aside
  class={`finding-card type-${type} reveal`}
  aria-label={`${type}: ${title}`}
>
  <span class="finding-icon-wrapper" aria-hidden="true">
    <i class={`ph ${icon} finding-icon`}></i>
  </span>
  <div class="finding-content">
    <h4 class="finding-title">{title}</h4>
    <div class="finding-body">
      {description ? <p>{description}</p> : <slot />}
    </div>
  </div>
</aside>

<style>
  .finding-card {
    display: flex;
    gap: 1.25rem;
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: 0.875rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .finding-icon-wrapper {
    flex-shrink: 0;
    padding-top: 0.125rem;
  }

  .finding-icon {
    font-size: 1.5rem;
  }

  .finding-content {
    flex: 1;
    min-width: 0;
  }

  .finding-title {
    margin: 0 0 0.375rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-secondary);
    line-height: 1.3;
  }

  .finding-body {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-gray-300);
    margin: 0;
  }

  .finding-body p {
    margin: 0;
  }

  /* Type variants */
  .type-critical {
    border-color: rgba(239, 68, 68, 0.3);
    background: rgba(239, 68, 68, 0.05);
  }
  .type-warning {
    border-color: rgba(245, 158, 11, 0.3);
    background: rgba(245, 158, 11, 0.05);
  }
  .type-opportunity {
    border-color: rgba(var(--color-accent-rgb), 0.3);
    background: rgba(var(--color-accent-rgb), 0.05);
  }
  .type-tip {
    border-color: rgba(59, 130, 246, 0.3);
    background: rgba(59, 130, 246, 0.05);
  }

  .type-critical .finding-icon,
  .type-critical .finding-title {
    color: #f87171;
  }
  .type-warning .finding-icon,
  .type-warning .finding-title {
    color: #facc15;
  }
  .type-opportunity .finding-icon {
    color: var(--color-accent);
  }
  .type-tip .finding-icon,
  .type-tip .finding-title {
    color: #60a5fa;
  }
</style>
